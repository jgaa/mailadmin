[Unit]
Description=Publish managed Courier configuration
After=mariadb.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/mailadmin-publish
User=root
Group=root
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/courier /etc/mailadmin/generated /run/lock
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=150
